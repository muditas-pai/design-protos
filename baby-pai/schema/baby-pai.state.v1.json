{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "baby-pai.state.v1.json",
  "title": "baby PAI scenario (state file) v1",
  "type": "object",
  "required": ["id", "role", "surface", "register", "now", "user", "content", "location", "overlays"],
  "additionalProperties": false,

  "properties": {
    "$schema": { "type": "string" },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "MUST equal the filename stem. ?state=<id> loads scenarios/<id>.json — that is the whole resolution rule; there is no index."
    },
    "role": {
      "enum": ["default", "empty", "loading", "error", "success"],
      "description": "The harness's existing state vocabulary. Written to body.dataset.state, so every legacy [data-state] branch keeps working."
    },
    "branch": {
      "type": "string",
      "description": "Optional override for body.dataset.state when the CSS branch name must differ from role."
    },
    "title": { "type": "string", "description": "Human label for the gate and the run log. Never rendered." },

    "surface": {
      "enum": ["Landing page hero", "Landing page features / sections", "Pricing page",
               "Upgrade-to-Pro modal", "Plan-comparison table", "Offer banner", "Dashboard",
               "Slide editor", "Settings, account, integrations", "Empty states",
               "Onboarding entry tiles", "unclassified"]
    },
    "register": {
      "enum": ["Marketing", "Growth", "Marketing-in-app", "App", "App-marketing-adjacent"]
    },

    "seed": { "type": "integer", "minimum": 0, "default": 1,
      "description": "Seeds the PRNG that replaces Math.random. Same seed, same pixels." },
    "now": { "type": "string", "format": "date-time",
      "description": "THE FROZEN CLOCK. The only time value in the system. Date.now() is overridden to return this." },

    "user": {
      "type": "object",
      "required": ["plan_id"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "initials": { "type": "string", "maxLength": 3 },
        "workspace": { "type": "string" },
        "locale": { "type": "string" },
        "plan_id": { "enum": ["free", "pro", "gold", "team", "enterprise"],
          "description": "An ID into content.md, never a display name and never a price. Lint fails the run if content.md has no such plan." },
        "plan_period": { "enum": ["monthly", "annual", "trial", null] },
        "tenure_days": { "type": "integer", "minimum": 0 },
        "trial": {
          "oneOf": [
            { "type": "null" },
            { "type": "object", "required": ["days_remaining"], "additionalProperties": false,
              "properties": {
                "days_remaining": { "type": "integer", "minimum": 0, "maximum": 365,
                  "description": "An INTEGER, never a date. ends_on is derived from now + this." },
                "of": { "type": "integer", "minimum": 1 },
                "converts_to": { "enum": ["free", "pro", "gold", "team", "enterprise"] },
                "card_on_file": { "type": "boolean" }
              } }
          ]
        },
        "credits": {
          "oneOf": [
            { "type": "null" },
            { "type": "object", "required": ["included", "used"], "additionalProperties": false,
              "properties": {
                "included": { "type": "integer", "minimum": 0 },
                "used": { "type": "integer", "minimum": 0 },
                "resets_in_days": { "type": "integer", "minimum": 0 }
              },
              "description": "remaining and pct_used are DERIVED and must not appear. No derivable field is ever stored." }
          ]
        },
        "team": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "in_team": { "type": "boolean" },
            "role": { "enum": ["owner", "admin", "member", null] },
            "seats_total": { "type": "integer", "minimum": 1 },
            "seats_used": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },

    "content": {
      "type": "object",
      "description": "What exists. Arrays are either literal [] or a $ref into fixtures.json with a `take`. Never sampled, never shuffled — take is the first N, in order.",
      "additionalProperties": {
        "oneOf": [
          { "type": "array" },
          { "type": "object", "required": ["$ref"], "additionalProperties": false,
            "properties": {
              "$ref": { "type": "string" },
              "take": { "type": "integer", "minimum": 0 },
              "starred": { "type": "array", "items": { "type": "integer", "minimum": 0 } }
            } }
        ]
      }
    },

    "location": {
      "type": "object", "required": ["route", "surface"], "additionalProperties": false,
      "properties": {
        "route": { "type": "string", "pattern": "^/" },
        "surface": { "enum": ["dashboard", "editor", "pricing", "settings", "onboarding", "landing"],
          "description": "Which baby-PAI shell renders. Written to body.dataset.route." },
        "focus": {
          "oneOf": [ { "type": "null" },
            { "type": "object", "additionalProperties": false,
              "properties": { "deck": { "type": "integer" }, "slide": { "type": "integer" }, "field": { "type": "string" } } } ]
        }
      }
    },

    "overlays": {
      "type": "object", "additionalProperties": false,
      "description": "What is currently open. At most one modal. This is what a lone-file artifact could never say.",
      "properties": {
        "modal": {
          "oneOf": [ { "type": "null" },
            { "type": "object", "required": ["id"], "additionalProperties": false,
              "properties": {
                "id": { "type": "string" },
                "reason": { "type": "string", "description": "Why it opened. The product judge reads this." },
                "dismissible": { "type": "boolean" },
                "offer_id": { "type": ["string", "null"] },
                "highlight_plan": { "enum": ["free", "pro", "gold", "team", "enterprise", null] }
              } } ]
        },
        "banner": {
          "oneOf": [ { "type": "null" },
            { "type": "object", "required": ["id"], "additionalProperties": false,
              "properties": {
                "id": { "type": "string" },
                "tone": { "enum": ["info", "warning", "danger", "promo"] },
                "dismissible": { "type": "boolean" },
                "cta": { "type": ["string", "null"] }
              } } ]
        },
        "toast": {
          "oneOf": [ { "type": "null" },
            { "type": "object", "required": ["id"], "additionalProperties": false,
              "properties": {
                "id": { "type": "string" },
                "tone": { "enum": ["info", "success", "warning", "danger"] },
                "ticking": { "type": "boolean", "default": false,
                  "description": "A toast never auto-dismisses under the renderer. ticking is forced false when frozen." }
              } } ]
        }
      }
    },

    "flags": {
      "type": "object", "additionalProperties": { "type": "boolean" },
      "description": "Feature flags. Each true flag becomes body.dataset.flag<CamelName>=\"on\"."
    },

    "continuity": {
      "type": "object", "additionalProperties": false,
      "description": "The scenario's neighbours. This is what makes 'what happens after the primary action' a checkable requirement instead of a hope.",
      "properties": {
        "entered_from": {
          "type": "object", "additionalProperties": false,
          "properties": { "scenario": { "type": ["string", "null"] }, "click": { "type": ["string", "null"] } }
        },
        "on_primary":   { "type": ["string", "null"] },
        "on_secondary": { "type": ["string", "null"] },
        "on_dismiss":   { "type": ["string", "null"] }
      }
    }
  }
}
