# The linter is python; keep its bytecode out of the repo.
__pycache__/
*.pyc

# Phosphor is vendored on purpose — see design-system/README.md
!design-system/icons/

# The two heavy asset tiers. `sync.sh --full-assets` pulls them for local work;
# they are 29 MB and never belong in this repo. `sync.sh --light-assets` undoes it.
assets/decks/*/full/
assets/features/*.mp4
assets/features/*.webm
